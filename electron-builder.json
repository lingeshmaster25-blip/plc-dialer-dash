{
  "appId": "com.plcdialer.dash",
  "productName": "PLC Dialer Dash",
  "copyright": "Copyright © 2026",

  "directories": {
    "output": "dist-electron",
    "buildResources": "build-resources"
  },

  "files": [
    "dist-spa/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],

  "extraResources": [
    {
      "from": "server",
      "to": "server",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!.gitignore",
        "!.env",
        "!.env.example",
        "!README.md"
      ]
    },
    {
      "from": "server/node_modules",
      "to": "server/node_modules",
      "filter": ["**/*"]
    }
  ],

  "asarUnpack": ["**/*.node"],

  "npmRebuild": false,

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PLC Dialer Dash"
  },

  "extraMetadata": {
    "main": "electron/main.cjs"
  }
}
